{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "长内容价值实验室领域事件",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "aggregate_type",
    "aggregate_id",
    "occurred_at",
    "version",
    "summary"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "enum": [
        "SIGNAL_RECORDED",
        "EXPERIMENT_ASSIGNED",
        "RISK_ACTION_APPLIED",
        "WINDOW_CLOSED",
        "POLICY_DECIDED"
      ]
    },
    "aggregate_type": {
      "type": "string",
      "enum": [
        "content_version",
        "signal_window",
        "experiment_assignment",
        "policy_decision"
      ]
    },
    "aggregate_id": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true
}
